{
  "name": "dailyrep-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build --configLoader runner",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/*.test.js",
    "test:ui": "node scripts/verify-web-dom.cjs",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm test && npm run test:worker && npm run build && node scripts/deploy-cloudflare.mjs",
    "cf:migrate": "wrangler d1 migrations apply dailyrep --remote",
    "test:worker": "node --test worker/*.test.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vite": "^7.0.0",
    "wrangler": "^4.153.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
